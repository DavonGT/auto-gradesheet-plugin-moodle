<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/gradesheet/db" VERSION="20261003"
    COMMENT="Grade Sheet Generator tables">
    <TABLES>
        <TABLE NAME="local_gradesheet_config" COMMENT="Grading formula config per course">
            <FIELDS>
                <FIELD NAME="id"             TYPE="int"    LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="courseid"       TYPE="int"    LENGTH="10" NOTNULL="true"/>
                <FIELD NAME="timecreated"    TYPE="int"    LENGTH="10" NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="timemodified"   TYPE="int"    LENGTH="10" NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="semester"       TYPE="char"   LENGTH="50" NOTNULL="false" DEFAULT="Second Semester"/>
                <FIELD NAME="schoolyear"     TYPE="char"   LENGTH="20" NOTNULL="false" DEFAULT="2025-2026"/>
                <FIELD NAME="coursenumber"   TYPE="char"   LENGTH="50" NOTNULL="false" DEFAULT=""/>
                <FIELD NAME="descriptive"    TYPE="char"   LENGTH="100" NOTNULL="false" DEFAULT=""/>
                <FIELD NAME="courseandyear"  TYPE="char"   LENGTH="50" NOTNULL="false" DEFAULT=""/>
                <FIELD NAME="schedule"       TYPE="char"   LENGTH="50" NOTNULL="false" DEFAULT=""/>
                <FIELD NAME="units"          TYPE="char"   LENGTH="10" NOTNULL="false" DEFAULT="3"/>
                <FIELD NAME="instructor"     TYPE="char"   LENGTH="100" NOTNULL="false" DEFAULT=""/>
                <FIELD NAME="department_head" TYPE="char"  LENGTH="100" NOTNULL="false" DEFAULT=""/>
                <FIELD NAME="registrar"      TYPE="char"   LENGTH="100" NOTNULL="false" DEFAULT=""/>
                <FIELD NAME="college_dean"   TYPE="char"   LENGTH="100" NOTNULL="false" DEFAULT=""/>
                <FIELD NAME="missingaszero"  TYPE="int"    LENGTH="1"   NOTNULL="true"  DEFAULT="0" COMMENT="1 = ungraded mapped items count as 0%"/>
                <FIELD NAME="includehidden"  TYPE="int"    LENGTH="1"   NOTNULL="true"  DEFAULT="1" COMMENT="1 = hidden grade items are included in faculty computation"/>
                <FIELD NAME="midtermweight"  TYPE="number" LENGTH="5"   DECIMALS="2" NOTNULL="true" DEFAULT="50" COMMENT="Midterm share of the final average, in percent"/>
                <FIELD NAME="roundaverage"   TYPE="int"    LENGTH="1"   NOTNULL="true"  DEFAULT="0" COMMENT="1 = round period/final averages to whole numbers before transmutation"/>
                <FIELD NAME="transmutemode"  TYPE="char"   LENGTH="20"  NOTNULL="true"  DEFAULT="essu" COMMENT="essu = built-in ESSU band interpolation; formula = faculty formula in P"/>
                <FIELD NAME="formula"        TYPE="char"   LENGTH="255" NOTNULL="false" DEFAULT="" COMMENT="Transmutation expression in P (raw percentage)"/>
                <FIELD NAME="formulamin"     TYPE="number" LENGTH="10"  DECIMALS="2" NOTNULL="false" COMMENT="Lowest transmuted value allowed (clamp), null = none"/>
                <FIELD NAME="formulamax"     TYPE="number" LENGTH="10"  DECIMALS="2" NOTNULL="false" COMMENT="Highest transmuted value allowed (clamp), null = none"/>
                <FIELD NAME="formuladecimals" TYPE="int"   LENGTH="1"   NOTNULL="true"  DEFAULT="1" COMMENT="Decimal places shown for the transmuted value"/>
                <FIELD NAME="passmark"       TYPE="number" LENGTH="5"   DECIMALS="2" NOTNULL="true" DEFAULT="75" COMMENT="Raw percentage at or above which a student passes (formula mode)"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="courseid" UNIQUE="true" FIELDS="courseid"/>
            </INDEXES>
        </TABLE>
        <TABLE NAME="local_gradesheet_itemmap" COMMENT="Maps grade items to Midterm or Finals">
            <FIELDS>
                <FIELD NAME="id"         TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="courseid"   TYPE="int"  LENGTH="10" NOTNULL="true"/>
                <FIELD NAME="gradeitemid" TYPE="int" LENGTH="10" NOTNULL="true"/>
                <FIELD NAME="period"     TYPE="char" LENGTH="10" NOTNULL="true" DEFAULT="finals"/>
                <FIELD NAME="categoryid" TYPE="int" LENGTH="10" NOTNULL="false" DEFAULT="0"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="courseid_itemid" UNIQUE="true" FIELDS="courseid, gradeitemid"/>
            </INDEXES>
        </TABLE>
        <TABLE NAME="local_gradesheet_categories" COMMENT="Custom categories for Midterm or Finals">
            <FIELDS>
                <FIELD NAME="id"        TYPE="int"    LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="courseid"  TYPE="int"    LENGTH="10" NOTNULL="true"/>
                <FIELD NAME="name"      TYPE="char"   LENGTH="100" NOTNULL="true"/>
                <FIELD NAME="weight"    TYPE="number" LENGTH="5"  DECIMALS="2" NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="sortorder" TYPE="int"    LENGTH="5"  NOTNULL="true" DEFAULT="0"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="courseid" UNIQUE="false" FIELDS="courseid"/>
            </INDEXES>
        </TABLE>
        <TABLE NAME="local_gradesheet_transmute" COMMENT="Custom per-course grading/transmutation scale">
            <FIELDS>
                <FIELD NAME="id"         TYPE="int"    LENGTH="10"  NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="courseid"   TYPE="int"    LENGTH="10"  NOTNULL="true"/>
                <FIELD NAME="minscore"   TYPE="number" LENGTH="10" DECIMALS="2" NOTNULL="true"/>
                <FIELD NAME="maxscore"   TYPE="number" LENGTH="10" DECIMALS="2" NOTNULL="true"/>
                <FIELD NAME="equivalent" TYPE="char"   LENGTH="10"  NOTNULL="true"/>
                <FIELD NAME="descriptor" TYPE="char"   LENGTH="100" NOTNULL="false" DEFAULT=""/>
                <FIELD NAME="sortorder"  TYPE="int"    LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="ispassing"  TYPE="int"    LENGTH="1"   NOTNULL="true" DEFAULT="1"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="courseid" UNIQUE="false" FIELDS="courseid"/>
            </INDEXES>
        </TABLE>
        <TABLE NAME="local_gradesheet_status" COMMENT="Faculty-set status overrides (Incomplete/Dropped/WP/In Progress) per student per course">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="" SEQUENCE="false"
                    COMMENT="'' = active/computed normally, or one of: inc, dropped, wp, ip"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="courseid-userid" UNIQUE="true" FIELDS="courseid, userid"/>
            </INDEXES>
        </TABLE>
        <TABLE NAME="local_gradesheet_groupcfg" COMMENT="Per-section (Moodle group) report header overrides">
            <FIELDS>
                <FIELD NAME="id"            TYPE="int"  LENGTH="10"  NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="courseid"      TYPE="int"  LENGTH="10"  NOTNULL="true"/>
                <FIELD NAME="groupid"       TYPE="int"  LENGTH="10"  NOTNULL="true"/>
                <FIELD NAME="courseandyear" TYPE="char" LENGTH="50"  NOTNULL="false" DEFAULT=""/>
                <FIELD NAME="schedule"      TYPE="char" LENGTH="50"  NOTNULL="false" DEFAULT=""/>
                <FIELD NAME="instructor"    TYPE="char" LENGTH="100" NOTNULL="false" DEFAULT=""/>
                <FIELD NAME="timemodified"  TYPE="int"  LENGTH="10"  NOTNULL="true" DEFAULT="0"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="courseid_groupid" UNIQUE="true" FIELDS="courseid, groupid"/>
            </INDEXES>
        </TABLE>
    </TABLES>
</XMLDB>